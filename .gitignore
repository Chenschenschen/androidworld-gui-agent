# Credentials and personal settings (the template is safe to commit).
.env
.env.*
!.env.example

# Installed environments, dependency checkouts and downloaded tooling stay local.
/.venv/
/android_world/
/.tools/python/
/.tools/Open-AutoGLM/
/.tools/ADBKeyBoard/
/.tools/publish-pip-cache/
/.tools/uv-cache/
/.tools/tmp/
/.tools/publish_check_*/
/.review/venv/
/.review/gelab_reference/
/.review/upstream_*/
# Course originals and extracted/rendered copies remain local.
/course_content/
/.review/materials/
/.review/rendered/
node_modules/

# The hayati branch preserves project utilities and non-video runs.
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.idea/
.vscode/
# Exclude video files in all folders, including uppercase extensions.
*.[mM][pP]4
*.[mM][oO][vV]
*.[aA][vV][iI]
*.[mM][kK][vV]
*.[wW][eE][bB][mM]
*.[mM]4[vV]
*.[wW][mM][vV]
*.[mM][pP][eE][gG]
*.[mM][pP][gG]
*.3[gG][pP]
*.3[gG]2
*.[fF][lL][vV]
*.[tT][sS]
*.apk
